meta {
  name: Publicar tokens P2P con precio elegido
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/orders/sell
  body: json
  auth: bearer
}

headers {
  authorization: Bearer {{auth_token}}
  content-type: application/json
  accept: application/json
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "playerId": 2,
    "quantity": 5,
    "unitPrice": 85
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
