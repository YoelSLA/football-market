meta {
  name: Vender tokens al superusuario
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/orders/sell-official
  body: json
  auth: bearer
}

headers {
  authorization: Bearer {{auth_token}}
  content-type: application/json
  accept: application/json
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "playerId": 2,
    "quantity": 5
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
