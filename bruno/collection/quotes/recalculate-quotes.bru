meta {
  name: Recalcular cotizaciones
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/quotes/recalculate
  body: json
  auth: bearer
}

headers {
  authorization: Bearer {{auth_token}}
  content-type: application/json
  accept: application/json
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "strategy": "POSITIONAL_PERFORMANCE",
    "adjustmentFactor": 0.50,
    "variationCap": 0.25,
    "minPriceFloor": 1
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
