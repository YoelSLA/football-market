meta {
  name: Inicializar mercado (fecha actual UTC)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/quotes/initialize
  body: json
  auth: bearer
}

headers {
  authorization: Bearer {{auth_token}}
  content-type: application/json
  accept: application/json
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {}
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
