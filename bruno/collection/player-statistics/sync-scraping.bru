meta {
  name: Ejecutar lote de scraping de estadísticas
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/players/statistics/whoscored/sync/scraping
  body: json
  auth: bearer
}

headers {
  authorization: Bearer {{auth_token}}
  content-type: application/json
  accept: application/json
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "extractionDate": "2026-10-15",
    "maxPlayers": 1
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
