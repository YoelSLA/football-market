meta {
  name: Consultar cobertura con fecha
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/players/statistics/whoscored/coverage?source=SCRAPING&extractionDate=2026-10-15
  auth: bearer
}

headers {
  authorization: Bearer {{auth_token}}
  accept: application/json
}

auth:bearer {
  token: {{auth_token}}
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
