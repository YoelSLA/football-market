meta {
  name: Consultar cotización vigente
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/players/2/quotes/current
  body: none
  auth: bearer
}

headers {
  authorization: Bearer {{auth_token}}
  accept: application/json
}

auth:bearer {
  token: {{auth_token}}
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
