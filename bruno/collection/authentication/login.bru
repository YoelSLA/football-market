meta {
  name: Login correcto
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "usuario1@example.com",
    "password": "12345678"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const token = res.getBody().token;
    if (token) {
      bru.setVar('auth_token', token);
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
