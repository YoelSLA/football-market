meta {
  name: Obtener usuario sin token (401)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/auth/me
  body: none
  auth: bearer
}

headers {
  accept: application/json
}

auth:bearer {
  token: {{auth_token}}
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
