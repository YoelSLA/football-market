meta {
  name: Obtener usuario autenticado
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/auth/me
  auth: bearer
}

headers {
  authorization: Bearer {{auth_token}}
  accept: application/json
}

auth:bearer {
  token: {{auth_token}}
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
