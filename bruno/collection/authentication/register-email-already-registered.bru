meta {
  name: Registrar usuario - Email ya registrado (409)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "username": "otro.usuario",
    "email": "usuario@email.com",
    "password": "Password123"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
