meta {
  name: Consultar ranking por score
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/rankings/score
  body: none
  auth: bearer
}

params:query {
  page: 0
  size: 20
}

headers {
  authorization: Bearer {{auth_token}}
  accept: application/json
}

auth:bearer {
  token: {{auth_token}}
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
