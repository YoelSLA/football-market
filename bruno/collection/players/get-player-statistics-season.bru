meta {
  name: Consultar estadísticas de un jugador por temporada
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/players/7821/statistics?seasonKey=2025-2026
  auth: bearer
}

headers {
  authorization: Bearer {{auth_token}}
  accept: application/json
}

auth:bearer {
  token: {{auth_token}}
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
