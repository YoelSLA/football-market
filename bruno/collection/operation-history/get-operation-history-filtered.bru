  body: none
  auth: bearer
}

params:query {
  page: 0
  size: 20
  search: Messi
  type: BUY
  executedFrom: 2026-01-01T00:00:00Z
  executedBefore: 2027-01-01T00:00:00Z
  sort: AMOUNT_DESC
