#!/bin/bash

echo "🚀 Ejecutando validaciones antes del push..."

echo ""
echo "🧪 Ejecutando tests del backend..."

cd backend || {
    echo "❌ No se encontró la carpeta backend."
    echo "🚫 Push cancelado."
    exit 1
}

if ! ./gradlew test --no-daemon; then
    echo ""
    echo "❌ Los tests del backend fallaron."
    echo "🚫 Push cancelado."
    exit 1
fi

echo ""
echo "✅ Todas las validaciones pasaron."
echo "🚀 Push permitido."