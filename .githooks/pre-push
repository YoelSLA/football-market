#!/bin/bash

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if git rev-parse --verify origin/dev >/dev/null 2>&1; then
    bash "$root/.githooks/flyway-migrations.sh" origin/dev HEAD || exit 1
fi

bash "$root/.githooks/backend-changes.sh"
classification_status=$?
if [[ "$classification_status" == 1 ]]; then
    echo "✅ Push sin cambios relevantes para backend: se omite fastTest."
    exit 0
fi

echo "🧪 Cambios relevantes o detección incierta: ejecutando fastTest sin cobertura..."
echo "ℹ️ Se valida el árbol local; CI verifica el código integrado."
cd "$root/backend" || exit 1
if ! ./gradlew fastTest; then
    echo "❌ Falló la validación rápida del backend. Push cancelado."
    exit 1
fi
echo "✅ Validación rápida satisfactoria. Push permitido."
